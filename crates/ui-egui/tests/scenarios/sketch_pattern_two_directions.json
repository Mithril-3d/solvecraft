  {"expect":{"query":{"command":"sketch.inspect","path":["curves",7,"center_at",0],"value":51}}},
  {"expect":{"query":{"command":"sketch.inspect","path":["curves",7,"center_at",1],"value":13}}},
  {"call":"ui.view","params":{"view":"fit"}},
  {"shot":"sketch_pattern_two_directions_before"},
  {"call":"engine.execute","params":{"command":"sketch.drag","params":{"entity":"seed.center","from":[5,5],"to":[7,8]}}},
  {"expect":{"query":{"command":"sketch.inspect","path":["curves",7,"center_at",0],"value":53}}},
  {"expect":{"query":{"command":"sketch.inspect","path":["curves",7,"center_at",1],"value":16}}},
  {"call":"engine.execute","params":{"command":"sketch.constraint.fix","params":{"entities":["seed"],"fixed":true}}},
  {"call":"engine.execute","params":{"command":"sketch.constraint.fix","params":{"entities":["guide2"],"fixed":false}}},
  {"call":"engine.execute","params":{"command":"sketch.constraint.fix","params":{"entities":["guide2.start"],"fixed":true}}},
  {"call":"engine.execute","params":{"command":"sketch.drag","params":{"entity":"guide2.end","from":[12,-14],"to":[16,-18]}}},
  {"expect":{"query":{"command":"sketch.inspect","path":["curves",7,"center_at",0],"value":55}}},
  {"expect":{"query":{"command":"sketch.inspect","path":["curves",7,"center_at",1],"value":14}}},
  {"expect":{"errors":0,"sketch_curves":{"own":8}}},
  {"shot":"sketch_pattern_two_directions_after"}
