[
  {"note":"The PATTERN toolbar opens a linear pattern with two independent picked direction lines. Copies follow the original and both lines."},
  {"call":"engine.execute","params":{"command":"sketch.create","params":{"plane":"XY"}}},
  {"call":"engine.execute","params":{"command":"sketch.circle.center","params":{"center":[5,5],"radius":2,"id":"seed"}}},
  {"call":"engine.execute","params":{"command":"sketch.line","params":{"points":[[0,-10],[20,-10]],"ids":["guide1"]}}},
  {"call":"engine.execute","params":{"command":"sketch.line","params":{"points":[[0,-30],[12,-14]],"ids":["guide2"]}}},
  {"call":"engine.execute","params":{"command":"sketch.constraint.fix","params":{"entities":["guide1","guide2"],"fixed":true}}},
  {"call":"ui.view","params":{"view":"top"}},
  {"click":{"handle":"toolbar:sketch.pattern.rectangular"}},
  {"click":{"sketch":[7,5]}},
  {"click":{"handle":"dialog:Direction"}},
  {"click":{"sketch":[10,-10]}},
  {"click":{"handle":"dialog:Direction 2"}},
  {"click":{"sketch":[6,-22]}},
  {"click":{"handle":"dialog:Quantity"}}, {"key":"A","cmd":true}, {"text":"3"},
  {"click":{"handle":"dialog:Spacing"}}, {"key":"A","cmd":true}, {"text":"20"},
  {"click":{"handle":"dialog:Quantity 2"}}, {"key":"A","cmd":true}, {"text":"2"},
  {"click":{"handle":"dialog:Spacing 2"}}, {"key":"A","cmd":true}, {"text":"10"},
  {"expect":{"dialog":"PatternRect","errors":0,"sketch_curves":{"own":3}}},
  {"shot":"sketch_pattern_two_directions_preview"},
  {"click":{"handle":"dialog:OK"}},
